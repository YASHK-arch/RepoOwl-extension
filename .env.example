# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Extension (anon key — read-only on issues; prompt saves use anonymous auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Enable "Anonymous sign-ins" in Supabase Dashboard → Authentication → Providers
# before using the extension settings page to save custom prompts.

# Groq — create at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
VITE_GROQ_API_KEY=gsk_...

# GitHub Actions worker
GITHUB_TOKEN=your-github-token

# ── OAuth App Client IDs (PUBLIC — safe to commit) ────────────────────────────
# Create a GitHub OAuth App: github.com → Settings → Developer Settings → OAuth Apps
VITE_GITHUB_CLIENT_ID=your-github-oauth-client-id
# Create a Supabase OAuth App: app.supabase.com → Account → OAuth Apps
VITE_SUPABASE_OAUTH_CLIENT_ID=your-supabase-oauth-client-id

# ── Central Hub Edge Function URL ─────────────────────────────────────────────
# Base URL for your Central Hub Supabase Edge Functions.
# Defaults to VITE_SUPABASE_URL/functions/v1 if not set.
VITE_HUB_EDGE_FUNCTION_BASE_URL=https://your-hub-project.supabase.co/functions/v1

# ── OAuth App Client Secrets (PRIVATE — set as Edge Function secrets only) ────
# Run: supabase secrets set GITHUB_CLIENT_SECRET=xxx SUPABASE_OAUTH_CLIENT_SECRET=xxx
# DO NOT put secrets in this file or commit them to version control.
